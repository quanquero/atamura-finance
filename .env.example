# Скопируй этот файл в .env (рядом с parser_1c_odata.py) и заполни.
# .env в git НЕ коммитится (см. .gitignore) — пароль остаётся только на машине/сервере.

# Адрес OData базы. На сервере 1С — localhost; с другого компа — http://192.168.0.200/<база>/odata/standard.odata
BASE=http://localhost/21_Silver_Development/odata/standard.odata

# 1С-логин/пароль для OData (лучше отдельный пользователь ТОЛЬКО НА ЧТЕНИЕ, не админ)
USER=
PASS=

# За сколько последних месяцев тянуть оплаты
MONTHS=1
