// Открыть состав стандартного интерфейса OData (нужные объекты) в базе 1С.
// Конфигурация: «Бухгалтерия для Казахстана 3.0».
//
// Как применить (ОДИН РАЗ НА БАЗУ):
//   1. Конфигуратор → Файл → Новый → Внешняя обработка (имя odata_setup).
//   2. Формы → добавить → Форма обработки. На вкладке «Команды» добавить Команда1, перетащить на форму.
//   3. Двойной клик по Команда1 → вставить весь код ниже в модуль формы. Ctrl+S (.epf).
//   4. Режим 1С:Предприятие → Файл → Открыть → выбрать .epf → нажать кнопку.
//   5. Проверить: http://<хост>/<база>/odata/standard.odata/  → в <workspace> появятся <collection>.
//
// Тот же .epf открываешь в каждой следующей базе — переписывать не нужно.

&НаКлиенте
Процедура Команда1(Команда)
    ВыполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере()
    Массив = Новый Массив;
    Доб = "";

    Спр = Метаданные.Справочники.Найти("Контрагенты");
    Если Спр <> Неопределено Тогда Массив.Добавить(Спр); Доб = Доб + "Контрагенты, "; КонецЕсли;

    // Документы: исходящие/входящие платежи + касса + поступление (имена подтверждены на базе KZ 3.0)
    Канд = "ПлатежноеПоручениеИсходящее,ПлатежныйОрдерСписаниеДенежныхСредств,РасходныйКассовыйОрдер,"
         + "ПлатежноеПоручениеВходящее,ПлатежныйОрдерПоступлениеДенежныхСредств,ПриходныйКассовыйОрдер,"
         + "ОплатаОтПокупателяПлатежнойКартой,ПоступлениеТоваровУслуг";
    Для Каждого Имя Из СтрРазделить(Канд, ",", Ложь) Цикл
        Об = Метаданные.Документы.Найти(Имя);
        Если Об <> Неопределено Тогда Массив.Добавить(Об); Доб = Доб + Имя + ", "; КонецЕсли;
    КонецЦикла;

    Если Массив.Количество() > 0 Тогда
        УстановитьСоставСтандартногоИнтерфейсаOData(Массив);
    КонецЕсли;
    Сообщить("ДОБАВЛЕНО: " + Доб);

    // Подсказка: имена документов, похожих на оплату/поступление (если что-то не нашлось в списке выше)
    Похожие = "";
    Для Каждого Д Из Метаданные.Документы Цикл
        Н = НРег(Д.Имя);
        Если Найти(Н,"списан")>0 ИЛИ Найти(Н,"платеж")>0 ИЛИ Найти(Н,"оплат")>0 ИЛИ Найти(Н,"поступл")>0 ИЛИ Найти(Н,"кассов")>0 Тогда
            Похожие = Похожие + Д.Имя + ", ";
        КонецЕсли;
    КонецЦикла;
    Сообщить("ПОХОЖИЕ ДОКУМЕНТЫ В БАЗЕ: " + Похожие);
КонецПроцедуры
